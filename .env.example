# Copy to .env and fill in. Never commit .env.

# Database: leave DB_HOST empty to use a local SQLite file.
# Local MySQL: DB_HOST=localhost   |   AWS: DB_HOST=<your RDS endpoint>
DB_HOST=
DB_PORT=3306
DB_NAME=resultcloud
DB_USER=admin
DB_PASSWORD=

# Amazon S3 bucket for marksheet PDFs (leave empty to skip uploads)
S3_BUCKET=
AWS_REGION=ap-south-1
# No AWS keys here: on EC2 the IAM role provides credentials.

# Flask
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_PASSWORD=
# Set to 1 only when the site runs over HTTPS
HTTPS=0
# File the CloudWatch agent ships (set on EC2)
LOG_FILE=
